{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
"typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "allowSyntheticDefaultImports": true,

    "types": ["node"]
  },

  "include": ["src"],

  "exclude": ["node_modules", "dist"]
}
